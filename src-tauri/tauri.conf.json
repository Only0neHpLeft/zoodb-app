{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZooDB",
  "version": "0.0.1",
  "identifier": "com.only0nehpleft.zoodb",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Zoo Database | v0.0.1",
        "width": 1400,
        "height": 1000,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc://localhost http://ipc.localhost https://*.neon.tech https://*.convex.cloud wss://*.convex.cloud https://*.convex.site https://github.com https://api.github.com; frame-src 'self'; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["zoodb"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Only0neHpLeft/zoodb-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNkQ3NDc0MjQ4NDc1QTIKUldTaWRZUWtkSFJ0MHQxNS9DZjR2aml3ZjBOWENIR1pueXFiZHhBakNobTB3Uzd1Mk1hS2x3QnAK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.13",
      "dmg": {
        "background": "dmg-background.png",
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
